{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llamask.local/schemas/sidecar-request.schema.json",
  "title": "LlaMask sidecar request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "detector_id",
    "document_id",
    "part_id",
    "offset_unit",
    "text",
    "candidates"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "detector_id": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "part_id": { "type": "string", "minLength": 1 },
    "offset_unit": { "const": "unicode_scalar" },
    "text": { "type": "string" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "entity_type": {
      "enum": [
        "PERSON_NAME",
        "ORG_NAME",
        "ADDRESS",
        "PHONE_NUMBER",
        "EMAIL",
        "CN_ID_NUMBER",
        "BANK_CARD_NUMBER",
        "FINANCIAL_AMOUNT",
        "SALARY_AMOUNT",
        "BUSINESS_METRIC",
        "PROJECT_CODE",
        "CONTRACT_ID",
        "CUSTOMER_NAME"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "entity_type",
        "matched_text",
        "detector",
        "confidence"
      ],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "entity_type": { "$ref": "#/$defs/entity_type" },
        "matched_text": { "type": "string", "minLength": 1 },
        "detector": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
