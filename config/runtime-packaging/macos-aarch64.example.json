{
  "schema_version": 1,
  "detectors": [
    {
      "id": "pp_ocr_small",
      "kind": "ocr",
      "executable": "ocr/python/bin/python3",
      "working_directory": "ocr",
      "args": [
        "sidecar/main.py",
        "--tier",
        "small",
        "--detector-model",
        "models/det",
        "--recognizer-model",
        "models/rec"
      ],
      "assets": [
        "ocr/python",
        "ocr/sidecar",
        "ocr/models"
      ],
      "timeout_ms": 120000
    }
  ],
  "tools": [
    {
      "kind": "pdfinfo",
      "executable": "pdf/bin/pdfinfo",
      "assets": [
        "pdf/lib"
      ]
    },
    {
      "kind": "pdftoppm",
      "executable": "pdf/bin/pdftoppm",
      "assets": [
        "pdf/lib"
      ]
    }
  ]
}
